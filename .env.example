# RenCrow_LLM Gateway credential (optional)
# RENCROW_LLM_API_KEY=

# Chat channels
# TELEGRAM_BOT_TOKEN=123456:ABC...
# DISCORD_BOT_TOKEN=xxx
# RENCROW_CHANNELS_LINE_ENABLED=true
# RENCROW_CHANNELS_LINE_CHANNEL_SECRET=xxx
# RENCROW_CHANNELS_LINE_CHANNEL_ACCESS_TOKEN=xxx
# RENCROW_CHANNELS_LINE_WEBHOOK_HOST=0.0.0.0
# RENCROW_CHANNELS_LINE_WEBHOOK_PORT=18791
# RENCROW_CHANNELS_LINE_WEBHOOK_PATH=/webhook/line

# Ops watchdog
# RENCROW_WATCHDOG_LOG_DIR=~/.rencrow/logs/watchdog
# RENCROW_WATCHDOG_RENCROW_URL=http://127.0.0.1:18790
# RENCROW_WATCHDOG_HEALTH_URL=http://127.0.0.1:18790/health
# RENCROW_WATCHDOG_TAILSCALE_HOST=
# RENCROW_WATCHDOG_VIEWER_URL=
# RENCROW_WATCHDOG_SERVE_TARGET=http://127.0.0.1:18790
# RENCROW_WATCHDOG_LOCAL_TIMEOUT_SEC=3
# RENCROW_WATCHDOG_EXTERNAL_TIMEOUT_SEC=5
# RENCROW_WATCHDOG_INTERVAL_SEC=60

# Web search (optional)
# BRAVE_SEARCH_API_KEY=BSA...

# Movie catalog crawler sidecar (optional; CORE returns 503 when unset)
# RENCROW_MOVIE_CATALOG_CRAWLER_URL=http://127.0.0.1:8790

TZ=Asia/Tokyo
