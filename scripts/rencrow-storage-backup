#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

mode=${1:-}
core_export=false
migration_output_dir=${2:-}
case ${mode} in
  config|check|run)
    if (( $# != 1 )); then
      echo "usage: rencrow-storage-backup {config|check|run}" >&2
      exit 2
    fi
    ;;
  core-export)
    if (( $# != 2 )) || [[ -z ${migration_output_dir} ]]; then
      echo "usage: rencrow-storage-backup core-export OUTPUT_DIR" >&2
      exit 2
    fi
    core_export=true
    ;;
  *)
    echo "usage: rencrow-storage-backup {config|check|run|core-export OUTPUT_DIR}" >&2
    exit 2
    ;;
esac
if [[ ${core_export} == true && ${migration_output_dir} != /srv/rencrow/backup/recovery/* ]]; then
  echo "[NG] CORE migration output must be under the production recovery root" >&2
  exit 2
fi

config_file=${RENCROW_CONFIG:-${HOME}/.rencrow/config/core.yaml}
rencrow_binary=${RENCROW_BINARY:-/home/nyukimi/.local/bin/rencrow}
restore_checker=${RENCROW_RESTORE_CHECKER:-/home/nyukimi/.local/bin/rencrow-storage-restore-check}
durable_snapshot_binary=${RENCROW_DURABLE_SNAPSHOT_BINARY:-/home/nyukimi/.local/bin/rencrow-durable-snapshot}
migration_packager=${RENCROW_MIGRATION_PACKAGER:-/home/nyukimi/.local/bin/rencrow-core-migration-package}
thread_migration_binary=${RENCROW_THREAD_MIGRATION_BINARY:-/home/nyukimi/.local/bin/rencrow-thread-migrate}
durable_manifest_dir=${RENCROW_DURABLE_MANIFEST_DIR:-${HOME}/.local/share/rencrow/config/durable-stores.d}
if [[ ! -f ${config_file} ]]; then
  echo "[NG] config file not found: ${config_file}" >&2
  exit 1
fi
if [[ ! -x ${rencrow_binary} ]]; then
  echo "[NG] rencrow binary not found: ${rencrow_binary}" >&2
  exit 1
fi

mapfile -t backup_config < <(RENCROW_CONFIG="${config_file}" "${rencrow_binary}" config backup-values)
if (( ${#backup_config[@]} != 21 )); then
  echo "[NG] failed to load complete backup config from ${config_file}" >&2
  exit 1
fi

core_root=${backup_config[0]}
core_snapshot_root=${backup_config[1]}
knowledge_root=${backup_config[2]}
knowledge_mirror=${backup_config[3]}
knowledge_versions=${backup_config[4]}
recent_keep=${backup_config[5]}
daily_keep=${backup_config[6]}
weekly_keep=${backup_config[7]}
monthly_keep=${backup_config[8]}
session_dir=${backup_config[9]}
operation_memory_dir=${backup_config[10]}
cold_export_dir=${backup_config[11]}
raw_source_dir=${backup_config[12]}
require_memory_exports=${backup_config[13]}
redis_enabled=${backup_config[14]}
redis_container=${backup_config[15]}
qdrant_enabled=${backup_config[16]}
qdrant_base_url=${backup_config[17]%/}
conversation_l1=${backup_config[18]}
conversation_archive=${backup_config[19]}
core_port=${backup_config[20]}
lock_file=/home/nyukimi/.cache/rencrow-storage-backup.lock
backup_mount=/srv/rencrow/backup
module_snapshot_root=${backup_mount}/snapshots/modules
module_receipt_root=${backup_mount}/receipts/modules

for retention in "${recent_keep}" "${daily_keep}" "${weekly_keep}" "${monthly_keep}"; do
  if [[ ! ${retention} =~ ^[1-9][0-9]*$ ]]; then
    echo "[NG] backup retention must be a positive integer" >&2
    exit 1
  fi
done
for boolean in "${require_memory_exports}" "${redis_enabled}" "${qdrant_enabled}"; do
  if [[ ${boolean} != true && ${boolean} != false ]]; then
    echo "[NG] backup boolean value is invalid: ${boolean}" >&2
    exit 1
  fi
done
if [[ ! ${core_port} =~ ^[0-9]+$ ]] || (( core_port < 1 || core_port > 65535 )); then
  echo "[NG] CORE readiness port is invalid" >&2
  exit 1
fi

wait_for_core_readiness() {
  local attempt
  for ((attempt = 1; attempt <= 300; attempt++)); do
    if systemctl --user is-active --quiet rencrow.service && \
      curl -fsS --max-time 2 "http://127.0.0.1:${core_port}/health/ready" 2>/dev/null \
        | python3 -c 'import json,sys; data=json.load(sys.stdin); raise SystemExit(0 if data.get("ready") is True else 1)' \
        >/dev/null 2>&1; then
      echo "[OK] CORE readiness restored after backup window"
      return 0
    fi
    sleep 1
  done
  echo "[NG] CORE readiness did not recover after backup window" >&2
  return 1
}

relative_to_core() {
  local path=$1
  if [[ ${path} == "${core_root}" ]]; then
    printf '.\n'
  elif [[ ${path} == "${core_root}/"* ]]; then
    printf '%s\n' "${path#"${core_root}/"}"
  else
    echo "[NG] configured path is outside core source: ${path}" >&2
    return 1
  fi
}

session_relative=$(relative_to_core "${session_dir}")
operation_memory_relative=$(relative_to_core "${operation_memory_dir}")
cold_export_relative=$(relative_to_core "${cold_export_dir}")
raw_source_relative=$(relative_to_core "${raw_source_dir}")
conversation_l1_relative=$(relative_to_core "${conversation_l1}")
conversation_archive_relative=$(relative_to_core "${conversation_archive}")

if [[ ${mode} == config ]]; then
  printf '%s\n' \
    "config=${config_file}" \
    "core_source=${core_root}" \
    "core_snapshot_root=${core_snapshot_root}" \
    "knowledge_source=${knowledge_root}" \
    "knowledge_mirror=${knowledge_mirror}" \
    "knowledge_versions=${knowledge_versions}" \
    "memory=session:${session_dir},operation:${operation_memory_dir},cold:${cold_export_dir}" \
    "raw_source=${raw_source_dir}" \
    "redis=enabled:${redis_enabled},container:${redis_container}" \
    "qdrant=enabled:${qdrant_enabled},base_url:${qdrant_base_url}" \
    "retention=recent:${recent_keep},daily:${daily_keep},weekly:${weekly_keep},monthly:${monthly_keep}"
  exit 0
fi

if [[ ! -d ${raw_source_dir} ]]; then
  echo "[NG] configured Common Raw source directory is missing: ${raw_source_dir}" >&2
  exit 1
fi

mkdir -p /home/nyukimi/.cache
exec 9>"${lock_file}"
if ! flock -n 9; then
  echo "[WARN] another backup process is running" >&2
  exit 0
fi

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "[NG] required command not found: $1" >&2
    exit 1
  fi
}

parse_thread_identity_capture_receipt() {
  python3 -c '
import json
import re
import sys

raw = sys.stdin.read()
if len(raw) > 65536 or not raw.endswith("\n") or raw.count("\n") != 1:
    raise SystemExit(1)
try:
    def reject_duplicate_keys(pairs):
        value = {}
        for key, item in pairs:
            if key in value:
                raise ValueError
            value[key] = item
        return value
    value = json.loads(raw[:-1], object_pairs_hook=reject_duplicate_keys)
except (TypeError, ValueError):
    raise SystemExit(1)
required = {
    "schema", "status", "redis_count", "qdrant_count",
    "redis_sha256", "qdrant_sha256", "snapshot_sha256", "error_code",
}
if set(value) != required:
    raise SystemExit(1)
if value.get("schema") != "rencrow.threadmigration.capture_external.v1":
    raise SystemExit(1)
if value.get("status") != "captured_not_quiescence_bound":
    raise SystemExit(1)
for key in ("redis_count", "qdrant_count"):
    count = value.get(key)
    if not isinstance(count, int) or isinstance(count, bool) or count < 0:
        raise SystemExit(1)
sha256_pattern = re.compile(r"^[0-9a-f]{64}$")
for key in ("redis_sha256", "qdrant_sha256", "snapshot_sha256"):
    if not isinstance(value.get(key), str) or not sha256_pattern.fullmatch(value[key]):
        raise SystemExit(1)
if value.get("error_code") != "":
    raise SystemExit(1)
print(value["snapshot_sha256"])
'
}

validate_thread_identity_quiesce_receipt() {
  python3 -c '
import hashlib
import json
import re
import sys

raw = sys.stdin.read()
if not raw.endswith("\n") or raw.count("\n") != 1:
    raise SystemExit(1)
try:
    value = json.loads(raw[:-1])
except (TypeError, ValueError):
    raise SystemExit(1)
required = [
    "schema_version", "status", "sqlite_sources", "busy_zero",
    "journal_mode_delete", "same_file", "sidecar_zero", "l1_sha256",
    "archive_sha256", "receipt_sha256", "error_code",
]
if list(value) != required:
    raise SystemExit(1)
if value.get("schema_version") != "rencrow.threadmigration.sqlite_quiesce.v1" or value.get("status") != "quiesced_not_snapshot_bound":
    raise SystemExit(1)
if value.get("sqlite_sources") != 2 or any(value.get(key) is not True for key in ("busy_zero", "journal_mode_delete", "same_file", "sidecar_zero")):
    raise SystemExit(1)
sha256_pattern = re.compile(r"^[0-9a-f]{64}$")
for key in ("l1_sha256", "archive_sha256", "receipt_sha256"):
    if not isinstance(value.get(key), str) or not sha256_pattern.fullmatch(value[key]):
        raise SystemExit(1)
if value.get("error_code") != "":
    raise SystemExit(1)
actual = value["receipt_sha256"]
value["receipt_sha256"] = ""
canonical = json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode()
if hashlib.sha256(canonical).hexdigest() != actual:
    raise SystemExit(1)
'
}

module_manifests=()
module_ids=()
module_roots=()
module_manifest_hashes=()
module_writers=()
declare -A module_writer_seen=()

load_durable_module_plans() {
  local expected manifest plan
  local -a discovered_manifests=()
  local -a values=()
  if [[ ! -d ${durable_manifest_dir} ]]; then
    echo "[NG] durable store manifest catalog is missing: ${durable_manifest_dir}" >&2
    return 1
  fi
  mapfile -d '' -t discovered_manifests < <(find "${durable_manifest_dir}" -maxdepth 1 -type f -name 'RenCrow_*.json' -print0 | sort -z)
  for manifest in "${discovered_manifests[@]}"; do
    expected=$(basename "${manifest}" .json)
    if [[ ${expected} == RenCrow_CORE ]]; then
      continue
    fi
    if [[ -L ${manifest} ]]; then
      echo "[NG] durable store manifest must not be a symlink: ${manifest}" >&2
      return 1
    fi
    if ! plan=$("${durable_snapshot_binary}" plan --manifest "${manifest}"); then
      echo "[NG] durable store plan failed: ${manifest}" >&2
      return 1
    fi
    mapfile -t values < <(python3 -c '
import json, sys
value = json.load(sys.stdin)
assert value.get("tool_revision")
assert value.get("module_id")
assert value.get("source_root")
assert value.get("manifest_sha256")
writers = value.get("authoritative_writers")
assert isinstance(writers, list) and writers
print(value["module_id"])
print(value["source_root"])
print(value["manifest_sha256"])
for writer in writers:
    assert isinstance(writer, str) and writer
    print(writer)
' <<<"${plan}")
    if (( ${#values[@]} < 4 )) || [[ ${values[0]} != "${expected}" ]]; then
      echo "[NG] durable store plan identity mismatch: ${manifest}" >&2
      return 1
    fi
    module_manifests+=("${manifest}")
    module_ids+=("${values[0]}")
    module_roots+=("${values[1]}")
    module_manifest_hashes+=("${values[2]}")
    local writer
    for writer in "${values[@]:3}"; do
      if [[ ! ${writer} =~ ^[A-Za-z0-9][A-Za-z0-9_.@-]*$ ]]; then
        echo "[NG] unsafe authoritative writer identity: ${writer}" >&2
        return 1
      fi
      if [[ -z ${module_writer_seen[${writer}]+x} ]]; then
        module_writer_seen[${writer}]=1
        module_writers+=("${writer}")
      fi
    done
  done
  if (( ${#module_manifests[@]} == 0 )); then
    echo "[NG] no installed non-CORE durable store manifests were found" >&2
    return 1
  fi
}

require_backing_mount() {
  local path=$1
  local mount_target
  if ! timeout 20 stat "${path}" >/dev/null 2>&1; then
    echo "[NG] required backing mount is inaccessible for ${path}" >&2
    return 1
  fi
  # systemd automount stacks an autofs mount and the real mount on the same
  # target, making findmnt return one line per layer. Keep the topmost mount.
  if ! mount_target=$(findmnt -n -o TARGET -T "${path}" | tail -n 1); then
    echo "[NG] required backing mount is inaccessible for ${path}" >&2
    return 1
  fi
  if [[ -z ${mount_target} || ${mount_target} == / ]] || ! mountpoint -q "${mount_target}"; then
    echo "[NG] required backing mount is inaccessible for ${path}" >&2
    exit 1
  fi
}

is_exact_mount() {
  local target=$1
  local mounted_target
  mounted_target=$(findmnt -rn -o TARGET -T "${target}" | tail -n 1 || true)
  [[ ${mounted_target} == "${target}" ]] && mountpoint -q "${target}"
}

backup_mounted_by_runner=false
cleanup_backup_mount() {
  if [[ ${backup_mounted_by_runner} == true ]] && is_exact_mount "${backup_mount}"; then
    umount "${backup_mount}"
    backup_mounted_by_runner=false
    echo "[OK] backup medium unmounted: ${backup_mount}"
  fi
}

cleanup_preflight() {
  local status=$?
  trap - EXIT INT TERM
  cleanup_backup_mount || status=1
  exit "${status}"
}
trap cleanup_preflight EXIT INT TERM

for command in basename curl cut docker find findmnt flock gzip install mount mountpoint python3 rsync sha256sum sort sync systemctl tar timeout umount; do
  require_command "${command}"
done
if [[ ${core_export} != true ]]; then
  if [[ ! -x ${durable_snapshot_binary} ]]; then
    echo "[NG] durable snapshot binary not found: ${durable_snapshot_binary}" >&2
    exit 1
  fi
  load_durable_module_plans
else
  if [[ ! -x ${thread_migration_binary} ]]; then
    echo "[NG] ThreadID migration binary not found" >&2
    exit 1
  fi
  if [[ ! -x ${migration_packager} ]]; then
    echo "[NG] CORE migration packager not found" >&2
    exit 1
  fi
fi
if [[ ${core_snapshot_root} != "${backup_mount}/"* || ${knowledge_mirror} != "${backup_mount}/"* || ${knowledge_versions} != "${backup_mount}/"* ]]; then
  echo "[NG] backup destinations must be under ${backup_mount}" >&2
  exit 1
fi
if ! is_exact_mount "${backup_mount}"; then
  mount "${backup_mount}"
  backup_mounted_by_runner=true
  echo "[OK] backup medium mounted: ${backup_mount}"
fi
require_backing_mount "${core_snapshot_root}"
if [[ ${core_export} == true ]]; then
  require_backing_mount "${migration_output_dir}"
else
  require_backing_mount "${knowledge_root}"
  require_backing_mount "${knowledge_mirror}"
  for module_root in "${module_roots[@]}"; do
    require_backing_mount "${module_root}"
  done
fi
backup_device=$(findmnt -n -o SOURCE -T "${backup_mount}" | tail -n 1)
database_device=$(findmnt -n -o SOURCE -T "${core_root}" | tail -n 1)
if [[ -z ${backup_device} || -z ${database_device} || ${backup_device} == "${database_device}" ]]; then
  echo "[NG] database and backup roots must use distinct mounted devices" >&2
  exit 1
fi

if [[ ${core_export} != true ]]; then
  mkdir -p \
    "${core_snapshot_root}/recent" \
    "${core_snapshot_root}/daily" \
    "${core_snapshot_root}/weekly" \
    "${core_snapshot_root}/monthly" \
    "${knowledge_mirror}" \
    "${knowledge_versions}" \
    "${module_snapshot_root}" \
    "${module_receipt_root}"
fi

check_redis() {
  docker inspect -f '{{.State.Running}}' "${redis_container}" | grep -qx true
  docker exec "${redis_container}" redis-cli ping | grep -qx PONG
}

check_qdrant() {
  curl -fsS "${qdrant_base_url}/snapshots" \
    | python3 -c 'import json,sys; value=json.load(sys.stdin); assert value.get("status") == "ok"'
}

if [[ ${redis_enabled} == true ]]; then
  check_redis
fi
if [[ ${qdrant_enabled} == true ]]; then
  check_qdrant
fi
if [[ ${require_memory_exports} == true && ( ${redis_enabled} != true || ${qdrant_enabled} != true ) ]]; then
  echo "[NG] required memory exporters are disabled" >&2
  exit 1
fi

if [[ ${mode} == check ]]; then
  if [[ ! -x ${restore_checker} ]]; then
    echo "[NG] restore checker not found: ${restore_checker}" >&2
    exit 1
  fi
  echo "[OK] all storage mounts and memory backends are available"
  du -sh "${core_root}" "${knowledge_root}" "${module_roots[@]}"
  rsync -rtn \
    --safe-links \
    --modify-window=1 \
    --exclude='.rsync-partial/' \
    "${knowledge_root}/" \
    "${knowledge_mirror}/"
  echo "[OK] backup dry-run completed"
  exit 0
fi

if [[ ! -x ${restore_checker} ]]; then
  echo "[NG] restore checker not found: ${restore_checker}" >&2
  exit 1
fi

timestamp=$(TZ=Asia/Tokyo date +%Y%m%d-%H%M%S)
hour=$(TZ=Asia/Tokyo date +%H)
weekday=$(TZ=Asia/Tokyo date +%u)
monthday=$(TZ=Asia/Tokyo date +%d)
staging=$(mktemp -d "/home/nyukimi/.cache/rencrow-backup.${timestamp}.XXXXXX")
core_was_active=false
core_masked_by_backup=false
qdrant_snapshot_name=
qdrant_snapshot_checksum=
core_snapshot_partial_parent=
thread_identity_snapshot_sha256=
thread_identity_quiesce_sha256=
snapshot_format_version=4
declare -A module_writer_was_active=()
declare -A module_writer_masked=()

stop_durable_module_writers() {
  local writer
  for writer in "${module_writers[@]}"; do
    if ! systemctl --user cat "${writer}.service" >/dev/null 2>&1; then
      echo "[NG] authoritative writer service is not installed: ${writer}.service" >&2
      return 1
    fi
    module_writer_was_active[${writer}]=false
    if systemctl --user is-active --quiet "${writer}.service"; then
      module_writer_was_active[${writer}]=true
    fi
    systemctl --user mask --runtime --now "${writer}.service"
    module_writer_masked[${writer}]=true
    if systemctl --user is-active --quiet "${writer}.service"; then
      echo "[NG] authoritative writer remained active after runtime mask: ${writer}.service" >&2
      return 1
    fi
  done
}

restore_durable_module_writers() {
  local status=0 writer
  for writer in "${module_writers[@]}"; do
    if [[ ${module_writer_masked[${writer}]:-false} == true ]]; then
      systemctl --user unmask --runtime "${writer}.service" || status=1
      module_writer_masked[${writer}]=false
    fi
  done
  for writer in "${module_writers[@]}"; do
    if [[ ${module_writer_was_active[${writer}]:-false} == true ]]; then
      systemctl --user start "${writer}.service" || status=1
      if ! systemctl --user is-active --quiet "${writer}.service"; then
        echo "[NG] authoritative writer did not return active: ${writer}.service" >&2
        status=1
      fi
      module_writer_was_active[${writer}]=false
    fi
  done
  return "${status}"
}

snapshot_durable_modules() {
  local index module_id module_slug source_root source_manifest staged_manifest snapshot_parent snapshot_dir receipt receipt_path
  for index in "${!module_ids[@]}"; do
    module_id=${module_ids[${index}]}
    module_slug=${module_id#RenCrow_}
    module_slug=${module_slug,,}
    source_root=${module_roots[${index}]}
    source_manifest=${module_manifests[${index}]}
    staged_manifest=${staging}/durable-manifests/${module_id}.json
    mkdir -p "${staging}/durable-manifests"
    install -m 0600 "${source_manifest}" "${staged_manifest}"
    if [[ $(sha256sum "${source_manifest}" | cut -d' ' -f1) != "${module_manifest_hashes[${index}]}" || \
          $(sha256sum "${staged_manifest}" | cut -d' ' -f1) != "${module_manifest_hashes[${index}]}" ]]; then
      echo "[NG] durable store manifest changed while freezing the backup plan: ${source_manifest}" >&2
      return 1
    fi
    snapshot_parent=${module_snapshot_root}/${module_slug}/recent
    mkdir -p "${snapshot_parent}"
    snapshot_dir=${snapshot_parent}/${timestamp}
    receipt=$("${durable_snapshot_binary}" create --manifest "${staged_manifest}" --source-root "${source_root}" --snapshot-dir "${snapshot_dir}")
    python3 -c '
import json, sys
value=json.load(sys.stdin)
assert value.get("contract_version") == "rencrow-durable-snapshot-receipt/v1"
assert value.get("operation") == "create"
assert value.get("status") == "completed"
assert value.get("tool_revision")
' <<<"${receipt}"
    receipt_path=${module_receipt_root}/${timestamp}-${module_slug}.json
    printf '%s\n' "${receipt}" > "${receipt_path}"
    chmod 0600 "${receipt_path}"
    sync "${receipt_path}"
    echo "[OK] durable module snapshot verified: ${module_id} ${snapshot_dir}"
  done
}

cleanup_qdrant_snapshot() {
  if [[ -n ${qdrant_snapshot_name} ]]; then
    curl -fsS -X DELETE "${qdrant_base_url}/snapshots/${qdrant_snapshot_name}" >/dev/null || true
    qdrant_snapshot_name=
  fi
}

cleanup() {
  local status=$?
  trap - EXIT INT TERM
  cleanup_qdrant_snapshot
  restore_durable_module_writers || status=1
  if [[ ${core_masked_by_backup} == true ]]; then
    systemctl --user unmask --runtime rencrow.service || status=1
    core_masked_by_backup=false
  fi
  if [[ ${core_was_active} == true ]] && ! systemctl --user is-active --quiet rencrow.service; then
    systemctl --user start rencrow.service || status=1
    wait_for_core_readiness || status=1
  fi
  if [[ -n ${staging:-} && -d ${staging} && ${staging} == /home/nyukimi/.cache/rencrow-backup.* ]]; then
    rm -rf -- "${staging}"
  fi
  if [[ -n ${core_snapshot_partial_parent:-} && -d ${core_snapshot_partial_parent} && \
        ${core_snapshot_partial_parent} == "${core_snapshot_root}/recent/.${timestamp}.partial."* ]]; then
    rm -rf -- "${core_snapshot_partial_parent}" || status=1
  fi
  cleanup_backup_mount || status=1
  exit "${status}"
}
trap cleanup EXIT INT TERM

if systemctl --user is-active --quiet rencrow.service; then
  core_was_active=true
fi
echo "[INFO] masking and stopping CORE for a consistent snapshot"
systemctl --user mask --runtime --now rencrow.service
core_masked_by_backup=true
if systemctl --user is-active --quiet rencrow.service; then
  echo "[NG] CORE remained active after runtime mask" >&2
  exit 1
fi
if [[ ${core_export} == true ]]; then
  thread_identity_snapshot_path=${staging}/external-memory/thread-identity/external-snapshot.json
  thread_identity_quiesce_path=${staging}/external-memory/thread-identity/sqlite-quiesce.json
  mkdir -p "${staging}/external-memory/thread-identity"
  if ! "${thread_migration_binary}" quiesce-sqlite --config "${config_file}" --initial-service-stopped >"${thread_identity_quiesce_path}" 2>/dev/null; then
    echo "[NG] ThreadID SQLite quiesce failed" >&2
    exit 1
  fi
  if [[ ! -f ${thread_identity_quiesce_path} || -L ${thread_identity_quiesce_path} || ! -s ${thread_identity_quiesce_path} ]] || \
     ! validate_thread_identity_quiesce_receipt <"${thread_identity_quiesce_path}"; then
    echo "[NG] ThreadID SQLite quiesce receipt is invalid" >&2
    exit 1
  fi
  thread_identity_quiesce_sha256=$(sha256sum "${thread_identity_quiesce_path}" | cut -d' ' -f1)
  if ! thread_identity_capture_receipt=$(
    "${thread_migration_binary}" capture-external --config "${config_file}" --output "${thread_identity_snapshot_path}" 2>/dev/null
  ); then
    echo "[NG] ThreadID logical snapshot capture failed" >&2
    exit 1
  fi
  if ! thread_identity_snapshot_sha256=$(printf '%s\n' "${thread_identity_capture_receipt}" | parse_thread_identity_capture_receipt); then
    echo "[NG] ThreadID logical snapshot capture receipt is invalid" >&2
    exit 1
  fi
  if [[ ! -f ${thread_identity_snapshot_path} || -L ${thread_identity_snapshot_path} || ! -s ${thread_identity_snapshot_path} ]]; then
    echo "[NG] ThreadID logical snapshot artifact is missing or empty" >&2
    exit 1
  fi
  snapshot_format_version=5
fi
if [[ ${core_export} != true ]]; then
  echo "[INFO] masking authoritative module writers for consistent snapshots"
  stop_durable_module_writers
  snapshot_durable_modules
fi

mkdir -p "${staging}/external-memory/redis" "${staging}/external-memory/qdrant"

if [[ ${redis_enabled} == true ]]; then
  redis_dir=$(docker exec "${redis_container}" redis-cli --raw CONFIG GET dir | tail -n 1)
  redis_filename=$(docker exec "${redis_container}" redis-cli --raw CONFIG GET dbfilename | tail -n 1)
  docker exec "${redis_container}" redis-cli SAVE | grep -qx OK
  docker exec "${redis_container}" redis-check-rdb "${redis_dir}/${redis_filename}"
  docker cp "${redis_container}:${redis_dir}/${redis_filename}" "${staging}/external-memory/redis/dump.rdb"
  [[ $(head -c 5 "${staging}/external-memory/redis/dump.rdb") == REDIS ]]
fi

if [[ ${qdrant_enabled} == true ]]; then
  qdrant_response="${staging}/qdrant-snapshot-response.json"
  curl -fsS -X POST "${qdrant_base_url}/snapshots" -o "${qdrant_response}"
  mapfile -t qdrant_meta < <(python3 -c 'import json,sys; result=json.load(open(sys.argv[1]))["result"]; print(result["name"]); print(result["checksum"])' "${qdrant_response}")
  qdrant_snapshot_name=${qdrant_meta[0]:-}
  qdrant_snapshot_checksum=${qdrant_meta[1]:-}
  if [[ -z ${qdrant_snapshot_name} || ${qdrant_snapshot_name} == */* || ! ${qdrant_snapshot_checksum} =~ ^[0-9a-f]{64}$ ]]; then
    echo "[NG] Qdrant returned unsafe or incomplete snapshot metadata" >&2
    exit 1
  fi
  curl -fsS "${qdrant_base_url}/snapshots/${qdrant_snapshot_name}" \
    -o "${staging}/external-memory/qdrant/${qdrant_snapshot_name}"
  [[ -s "${staging}/external-memory/qdrant/${qdrant_snapshot_name}" ]]
  printf '%s  %s\n' \
    "${qdrant_snapshot_checksum}" \
    "${staging}/external-memory/qdrant/${qdrant_snapshot_name}" \
    | sha256sum -c -
fi

core_parent=$(dirname "${core_root}")
core_name=$(basename "${core_root}")
archive="${staging}/rencrow-state.tar.gz"
tar \
  --acls \
  --xattrs \
  --numeric-owner \
  --exclude="${core_name}/.env" \
  --exclude="${core_name}/ssl/*.key" \
  --exclude="${core_name}/bin" \
  --exclude="${core_name}/logs" \
  --exclude="${core_name}/locks" \
  --exclude="${core_name}/tmp" \
  -C "${core_parent}" \
  -czf "${archive}" \
  "${core_name}" \
  -C "${staging}" \
  external-memory
gzip -t "${archive}"

restore_durable_module_writers

if [[ ${core_was_active} == true ]]; then
  systemctl --user unmask --runtime rencrow.service
  core_masked_by_backup=false
  systemctl --user start rencrow.service
  wait_for_core_readiness
  core_was_active=false
  echo "[OK] CORE restarted and ready"
fi

candidate_dir="${staging}/snapshot"
mkdir -p "${candidate_dir}"
mv "${archive}" "${candidate_dir}/rencrow-state.tar.gz"
(
  cd "${candidate_dir}"
  sha256sum rencrow-state.tar.gz > SHA256SUMS
)
printf '%s\n' \
  "format_version=${snapshot_format_version}" \
  "created_at_jst=${timestamp}" \
  "source=${core_root}" \
  "core_name=${core_name}" \
  "session_relative=${session_relative}" \
  "operation_memory_relative=${operation_memory_relative}" \
  "cold_export_relative=${cold_export_relative}" \
  "raw_source_relative=${raw_source_relative}" \
  "conversation_l1_relative=${conversation_l1_relative}" \
  "conversation_archive_relative=${conversation_archive_relative}" \
  "redis_export=$([[ ${redis_enabled} == true ]] && printf 'external-memory/redis/dump.rdb' || printf 'disabled')" \
  "qdrant_export=$([[ ${qdrant_enabled} == true ]] && printf 'external-memory/qdrant/%s' "${qdrant_snapshot_name}" || printf 'disabled')" \
  "qdrant_sha256=$([[ ${qdrant_enabled} == true ]] && printf '%s' "${qdrant_snapshot_checksum}" || printf 'disabled')" \
  'restore_format=tar.gz' \
  > "${candidate_dir}/manifest.txt"
if [[ ${snapshot_format_version} == 5 ]]; then
  printf '%s\n' \
    'thread_identity_export=external-memory/thread-identity/external-snapshot.json' \
    "thread_identity_snapshot_sha256=${thread_identity_snapshot_sha256}" \
    'thread_identity_quiesce_receipt=external-memory/thread-identity/sqlite-quiesce.json' \
    "thread_identity_quiesce_sha256=${thread_identity_quiesce_sha256}" \
    >> "${candidate_dir}/manifest.txt"
fi

"${restore_checker}" "${candidate_dir}"
if [[ ${core_export} == true ]]; then
  "${migration_packager}" --snapshot-dir "${candidate_dir}" --output-dir "${migration_output_dir}" >/dev/null
  sync "${migration_output_dir}"
  echo "[OK] CORE migration state package verified"
  exit 0
fi
snapshot_dir="${core_snapshot_root}/recent/${timestamp}"
core_snapshot_partial_parent=$(mktemp -d "${core_snapshot_root}/recent/.${timestamp}.partial.XXXXXX")
mv "${candidate_dir}" "${core_snapshot_partial_parent}/snapshot"
sync "${core_snapshot_partial_parent}/snapshot/rencrow-state.tar.gz" \
  "${core_snapshot_partial_parent}/snapshot/SHA256SUMS" \
  "${core_snapshot_partial_parent}/snapshot/manifest.txt"
sync "${core_snapshot_partial_parent}/snapshot" "${core_snapshot_partial_parent}"
mv "${core_snapshot_partial_parent}/snapshot" "${snapshot_dir}"
rmdir "${core_snapshot_partial_parent}"
core_snapshot_partial_parent=
sync "${core_snapshot_root}/recent"
cleanup_qdrant_snapshot

if [[ ${hour} == 03 ]]; then
  cp -a "${snapshot_dir}" "${core_snapshot_root}/daily/${timestamp}"
  if [[ ${weekday} == 7 ]]; then
    cp -a "${snapshot_dir}" "${core_snapshot_root}/weekly/${timestamp}"
  fi
  if [[ ${monthday} == 01 ]]; then
    cp -a "${snapshot_dir}" "${core_snapshot_root}/monthly/${timestamp}"
  fi
fi

prune_snapshots() {
  local root=$1
  local keep=$2
  local index=0
  local entry
  if [[ ${root} != "${core_snapshot_root}/"* ]]; then
    echo "[NG] refusing to prune outside snapshot root: ${root}" >&2
    return 1
  fi
  while IFS= read -r entry; do
    index=$((index + 1))
    if (( index > keep )); then
      rm -rf -- "${entry}"
    fi
  done < <(find "${root}" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -nr | cut -d' ' -f2-)
}

prune_snapshots "${core_snapshot_root}/recent" "${recent_keep}"
prune_snapshots "${core_snapshot_root}/daily" "${daily_keep}"
prune_snapshots "${core_snapshot_root}/weekly" "${weekly_keep}"
prune_snapshots "${core_snapshot_root}/monthly" "${monthly_keep}"

prune_module_snapshots() {
  local root=$1
  local keep=$2
  local index=0 entry
  if [[ ${root} != "${module_snapshot_root}/"*/recent ]]; then
    echo "[NG] refusing to prune outside module snapshot roots: ${root}" >&2
    return 1
  fi
  while IFS= read -r entry; do
    index=$((index + 1))
    if (( index > keep )); then
      rm -rf -- "${entry}"
    fi
  done < <(find "${root}" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -nr | cut -d' ' -f2-)
}

for module_id in "${module_ids[@]}"; do
  module_slug=${module_id#RenCrow_}
  module_slug=${module_slug,,}
  prune_module_snapshots "${module_snapshot_root}/${module_slug}/recent" "${recent_keep}"
done

version_dir="${knowledge_versions}/${timestamp}"
mkdir -p "${version_dir}"
rsync -rt \
  --safe-links \
  --modify-window=1 \
  --partial \
  --partial-dir=.rsync-partial \
  --backup \
  --backup-dir="${version_dir}" \
  "${knowledge_root}/" \
  "${knowledge_mirror}/"
rmdir "${version_dir}" 2>/dev/null || true

echo "[OK] CORE and memory snapshot verified: ${snapshot_dir}"
echo "[OK] knowledge backup: ${knowledge_mirror}"
