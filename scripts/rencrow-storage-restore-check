#!/usr/bin/env bash
set -Eeuo pipefail

current_bash_executable=${BASH:-}
if [[ ${current_bash_executable} != /* || ! -x ${current_bash_executable} ]]; then
  echo "[NG] selected Bash executable must be an absolute executable path" >&2
  exit 2
fi
case ${OSTYPE:-} in
  msys*|cygwin*|mingw*)
    if ! current_bash_executable=$(cygpath -aw "${current_bash_executable}"); then
      echo "[NG] selected Bash executable could not be converted to a native Windows path" >&2
      exit 2
    fi
    if [[ ${current_bash_executable} != *.exe ]]; then
      current_bash_executable=${current_bash_executable}.exe
    fi
    ;;
esac

python_bin=${RENCROW_TEST_PYTHON:-python3}
sqlite_integrity_timeout=${RENCROW_SQLITE_INTEGRITY_TIMEOUT_SEC:-600}
umask 077

if [[ ! ${sqlite_integrity_timeout} =~ ^[1-9][0-9]*$ ]] || (( sqlite_integrity_timeout > 3600 )); then
  echo "[NG] SQLite integrity timeout must be 1..3600 seconds" >&2
  exit 2
fi

snapshot_dir=${1:-}
if [[ -z ${snapshot_dir} || ! -d ${snapshot_dir} ]]; then
  echo "usage: rencrow-storage-restore-check SNAPSHOT_DIR" >&2
  exit 2
fi

archive=${snapshot_dir}/rencrow-state.tar.gz
manifest=${snapshot_dir}/manifest.txt
checksums=${snapshot_dir}/SHA256SUMS
for required in "${archive}" "${manifest}" "${checksums}"; do
  if [[ ! -f ${required} ]]; then
    echo "[NG] required snapshot file is missing: ${required}" >&2
    exit 1
  fi
done

manifest_value() {
  local key=$1
  awk -F= -v key="${key}" '$1 == key {sub(/^[^=]*=/, ""); print; exit}' "${manifest}"
}

format_version=$(manifest_value format_version)
core_name=$(manifest_value core_name)
session_relative=$(manifest_value session_relative)
operation_memory_relative=$(manifest_value operation_memory_relative)
cold_export_relative=$(manifest_value cold_export_relative)
raw_source_relative=$(manifest_value raw_source_relative)
conversation_l1_relative=$(manifest_value conversation_l1_relative)
conversation_archive_relative=$(manifest_value conversation_archive_relative)
redis_export=$(manifest_value redis_export)
qdrant_export=$(manifest_value qdrant_export)
qdrant_sha256=$(manifest_value qdrant_sha256)

if [[ ( ${format_version} != 2 && ${format_version} != 3 && ${format_version} != 4 ) || -z ${core_name} || ${core_name} == */* ]]; then
  echo "[NG] unsupported or unsafe snapshot manifest" >&2
  exit 1
fi

safe_relative() {
  local value=$1
  local normalized=${value//\\//}
  if [[ -z ${value} || ${value} == /* || ${value} == \\\\* || ${normalized} == /* || ${normalized} == *:* ]]; then
    return 1
  fi
  if [[ ${normalized} == . ]]; then
    return 0
  fi
  if [[ ${normalized} == */. || ${normalized} == */./* || ${normalized} == */../* || ${normalized} == .. || ${normalized} == ../* || ${normalized} == */.. ]]; then
    return 1
  fi
  local part
  IFS=/ read -r -a parts <<< "${normalized}"
  for part in "${parts[@]}"; do
    if [[ -z ${part} || ${part} == . || ${part} == .. ]]; then
      return 1
    fi
  done
  return 0
}

(
  cd "${snapshot_dir}"
  sha256sum -c SHA256SUMS
)
gzip -t "${archive}"

tar -tzf "${archive}" | "${python_bin}" -c '
import sys
for raw in sys.stdin:
    name = raw.strip()
    parts = [part for part in name.split("/") if part not in ("", ".")]
    if name.startswith("/") or ".." in parts:
        raise SystemExit("unsafe archive path: " + name)
'

restore_root=$(mktemp -d "${snapshot_dir}/.restore.XXXXXX")
sqlite_supervision_marker=${restore_root}/.sqlite-integrity-supervision-active
cleanup() {
  local status=$?
  trap - EXIT INT TERM
  if [[ -n ${restore_root:-} && -d ${restore_root} ]]; then
    if [[ -f ${sqlite_supervision_marker} ]]; then
      echo "[NG] owned SQLite worker teardown is unconfirmed; restore scratch was retained at ${restore_root}" >&2
      restore_root=
    else
      rm -rf -- "${restore_root}"
    fi
  fi
  exit "${status}"
}
trap cleanup EXIT INT TERM

tar -xzf "${archive}" -C "${restore_root}"
core_restore=${restore_root}/${core_name}

required_relatives=("${session_relative}" "${operation_memory_relative}" "${cold_export_relative}")
if [[ ${format_version} == 4 ]]; then
  required_relatives+=("${raw_source_relative}")
fi
for relative in "${required_relatives[@]}"; do
  if ! safe_relative "${relative}"; then
    echo "[NG] unsafe required directory in manifest: ${relative}" >&2
    exit 1
  fi
  if [[ ! -d ${core_restore}/${relative} ]]; then
    echo "[NG] required memory directory is missing from snapshot: ${relative}" >&2
    exit 1
  fi
done
for relative in "${conversation_l1_relative}" "${conversation_archive_relative}"; do
  if ! safe_relative "${relative}"; then
    echo "[NG] unsafe SQLite path in manifest" >&2
    exit 1
  fi
done

sqlite_timeout_marker=${restore_root}/.sqlite-integrity-timeout
set +e
# python3 is the existing operational interpreter and supervises the configured
# worker. RENCROW_TEST_PYTHON remains the worker executable, so its startup is
# covered by the deadline instead of starting the supervisor itself.
python3 - "${current_bash_executable}" "${python_bin}" "${sqlite_integrity_timeout}" "${sqlite_timeout_marker}" "${sqlite_supervision_marker}" \
  "${core_restore}/${conversation_l1_relative}" "${core_restore}/${conversation_archive_relative}" <<'PY'
import os
import signal
import stat
import subprocess
import sys
import tempfile
import time

current_bash_executable, worker_python, timeout_text, timeout_marker, supervision_marker, *database_paths = sys.argv[1:]
timeout_seconds = int(timeout_text)
deadline = time.monotonic() + timeout_seconds

worker_script = r'''import sqlite3
import sys

for path in sys.argv[1:]:
    if not path or "/../" in path:
        raise SystemExit("unsafe SQLite path")
    with open(path, "rb") as handle:
        if handle.read(16) != b"SQLite format 3\x00":
            raise SystemExit(f"not a SQLite database: {path}")
    connection = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
    try:
        result = connection.execute("PRAGMA integrity_check").fetchone()
    finally:
        connection.close()
    if not result or result[0] != "ok":
        raise SystemExit(f"SQLite integrity check failed: {path}: {result}")
'''


def process_group_exists(process):
    process.poll()
    try:
        os.killpg(process.pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def wait_for_process_group(process, seconds):
    until = time.monotonic() + seconds
    while process_group_exists(process):
        if time.monotonic() >= until:
            return False
        time.sleep(0.05)
    return True


def stop_posix_process_group(process):
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return True
    if wait_for_process_group(process, 0.5):
        return True
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        return True
    return wait_for_process_group(process, 2.0)


def close_stdin(process):
    if process.stdin is not None and not process.stdin.closed:
        try:
            process.stdin.close()
        except OSError:
            pass


def bash_argument(value):
    if os.name != "nt":
        return value
    if len(value) > 2 and value[1] == ":" and value[2] in "\\/":
        return "/" + value[0].lower() + "/" + value[3:].replace("\\", "/")
    if value.startswith("\\\\"):
        return value.replace("\\", "/")
    return value


def exit_on_signal(signum, _frame):
    raise SystemExit(128 + signum)


watched_signals = [signal.SIGINT, signal.SIGTERM]
if hasattr(signal, "SIGBREAK"):
    watched_signals.append(signal.SIGBREAK)
for watched_signal in watched_signals:
    signal.signal(watched_signal, exit_on_signal)


def capture_owned_scratch_identity(path):
    path = os.path.abspath(path)
    info = os.lstat(path)
    attributes = getattr(info, "st_file_attributes", 0)
    if (
        not stat.S_ISDIR(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or attributes & 0x00000400
    ):
        raise RuntimeError(f"owned restore scratch boundary is not an ordinary directory: {path}")
    return path, info.st_dev, info.st_ino


def cleanup_interrupted_scratch(
    root_path, snapshot_path, root_identity, snapshot_identity,
    supervision_marker, marker_identity,
):
    root_path = os.path.abspath(root_path)
    snapshot_path = os.path.abspath(snapshot_path)
    supervision_marker = os.path.abspath(supervision_marker)
    if os.path.dirname(supervision_marker) != root_path:
        return 125, "worker supervision marker is outside its owned restore root"

    def require_directory(path, expected_identity):
        info = os.lstat(path)
        attributes = getattr(info, "st_file_attributes", 0)
        if (
            not stat.S_ISDIR(info.st_mode)
            or stat.S_ISLNK(info.st_mode)
            or attributes & 0x00000400
            or (info.st_dev, info.st_ino) != expected_identity[1:]
        ):
            raise RuntimeError(f"restore scratch directory identity changed: {path}")

    def require_root():
        if os.path.dirname(root_path) != snapshot_path:
            raise RuntimeError("restore scratch root is not a direct child of its snapshot")
        require_directory(snapshot_path, snapshot_identity)
        require_directory(root_path, root_identity)

    def require_parent_chain(path):
        parent = os.path.dirname(path)
        while parent != root_path:
            if not parent.startswith(root_path + os.sep):
                raise RuntimeError(f"restore scratch entry escaped its owned root: {path}")
            info = os.lstat(parent)
            attributes = getattr(info, "st_file_attributes", 0)
            if (
                not stat.S_ISDIR(info.st_mode)
                or stat.S_ISLNK(info.st_mode)
                or attributes & 0x00000400
            ):
                raise RuntimeError(f"restore scratch parent is not an ordinary directory: {parent}")
            parent = os.path.dirname(parent)

    def require_owned_marker():
        require_root()
        if os.path.dirname(supervision_marker) != root_path:
            raise RuntimeError("worker supervision marker is outside its owned restore root")
        info = os.lstat(supervision_marker)
        attributes = getattr(info, "st_file_attributes", 0)
        if (
            not stat.S_ISREG(info.st_mode)
            or stat.S_ISLNK(info.st_mode)
            or attributes & 0x00000400
            or (info.st_dev, info.st_ino) != marker_identity
        ):
            raise RuntimeError("worker supervision marker ownership could not be confirmed")

    def remove_entry(path):
        require_owned_marker()
        require_parent_chain(path)
        before = os.lstat(path)
        identity = (before.st_dev, before.st_ino)
        attributes = getattr(before, "st_file_attributes", 0)
        is_reparse = bool(attributes & 0x00000400)
        is_link = stat.S_ISLNK(before.st_mode)

        if stat.S_ISDIR(before.st_mode) and not is_link and not is_reparse:
            with os.scandir(path) as entries:
                names = [entry.name for entry in entries]
            for name in names:
                remove_entry(os.path.join(path, name))
            require_owned_marker()
            require_parent_chain(path)
            after = os.lstat(path)
            if (after.st_dev, after.st_ino) != identity or not stat.S_ISDIR(after.st_mode):
                raise RuntimeError(f"restore scratch entry changed during cleanup: {path}")
            os.rmdir(path)
            return

        require_owned_marker()
        require_parent_chain(path)
        after = os.lstat(path)
        if (after.st_dev, after.st_ino) != identity:
            raise RuntimeError(f"restore scratch entry changed during cleanup: {path}")
        if is_reparse and stat.S_ISDIR(after.st_mode) and not is_link:
            os.rmdir(path)
        else:
            os.unlink(path)

    def recreate_marker_if_missing():
        if os.path.dirname(supervision_marker) != root_path:
            raise RuntimeError("worker supervision marker is outside its owned restore root")
        try:
            require_root()
            os.lstat(supervision_marker)
            return
        except FileNotFoundError:
            require_root()
            with open(supervision_marker, "x", encoding="ascii") as marker:
                marker.write("interrupted worker cleanup failed; scratch retained\n")
                marker.flush()

    try:
        require_root()
    except Exception as error:
        return 125, str(error)

    try:
        require_owned_marker()
        with os.scandir(root_path) as entries:
            names = [entry.name for entry in entries if os.path.abspath(entry.path) != supervision_marker]
        for name in names:
            remove_entry(os.path.join(root_path, name))

        require_owned_marker()
        os.unlink(supervision_marker)
        try:
            require_root()
        except FileNotFoundError:
            require_directory(snapshot_path, snapshot_identity)
            return 0, ""
        try:
            os.rmdir(root_path)
        except FileNotFoundError:
            require_directory(snapshot_path, snapshot_identity)
            try:
                os.lstat(root_path)
            except FileNotFoundError:
                return 0, ""
            raise
        except OSError:
            recreate_marker_if_missing()
            raise
        return 0, ""
    except Exception as error:
        try:
            recreate_marker_if_missing()
        except Exception as marker_error:
            return 125, f"{error}; supervision marker could not be preserved: {marker_error}"
        return 125, str(error)


def run_windows_owned_worker(worker_command):
    import ctypes
    import msvcrt
    from ctypes import wintypes

    DWORD = wintypes.DWORD
    BOOL = wintypes.BOOL
    HANDLE = wintypes.HANDLE
    SIZE_T = ctypes.c_size_t
    ULONG_PTR = ctypes.c_size_t
    LARGE_INTEGER = ctypes.c_longlong
    INVALID_HANDLE_VALUE = (1 << (ctypes.sizeof(ctypes.c_void_p) * 8)) - 1
    JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE = 0x00002000
    CREATE_SUSPENDED = 0x00000004
    CREATE_NEW_PROCESS_GROUP = 0x00000200
    EXTENDED_STARTUPINFO_PRESENT = 0x00080000

    class IO_COUNTERS(ctypes.Structure):
        _fields_ = [
            ("ReadOperationCount", ctypes.c_ulonglong),
            ("WriteOperationCount", ctypes.c_ulonglong),
            ("OtherOperationCount", ctypes.c_ulonglong),
            ("ReadTransferCount", ctypes.c_ulonglong),
            ("WriteTransferCount", ctypes.c_ulonglong),
            ("OtherTransferCount", ctypes.c_ulonglong),
        ]

    class JOBOBJECT_BASIC_LIMIT_INFORMATION(ctypes.Structure):
        _fields_ = [
            ("PerProcessUserTimeLimit", LARGE_INTEGER),
            ("PerJobUserTimeLimit", LARGE_INTEGER),
            ("LimitFlags", DWORD),
            ("MinimumWorkingSetSize", SIZE_T),
            ("MaximumWorkingSetSize", SIZE_T),
            ("ActiveProcessLimit", DWORD),
            ("Affinity", ULONG_PTR),
            ("PriorityClass", DWORD),
            ("SchedulingClass", DWORD),
        ]

    class JOBOBJECT_EXTENDED_LIMIT_INFORMATION(ctypes.Structure):
        _fields_ = [
            ("BasicLimitInformation", JOBOBJECT_BASIC_LIMIT_INFORMATION),
            ("IoInfo", IO_COUNTERS),
            ("ProcessMemoryLimit", SIZE_T),
            ("JobMemoryLimit", SIZE_T),
            ("PeakProcessMemoryUsed", SIZE_T),
            ("PeakJobMemoryUsed", SIZE_T),
        ]

    class JOBOBJECT_BASIC_ACCOUNTING_INFORMATION(ctypes.Structure):
        _fields_ = [
            ("TotalUserTime", LARGE_INTEGER),
            ("TotalKernelTime", LARGE_INTEGER),
            ("ThisPeriodTotalUserTime", LARGE_INTEGER),
            ("ThisPeriodTotalKernelTime", LARGE_INTEGER),
            ("TotalPageFaultCount", DWORD),
            ("TotalProcesses", DWORD),
            ("ActiveProcesses", DWORD),
            ("TotalTerminatedProcesses", DWORD),
        ]

    class STARTUPINFOW(ctypes.Structure):
        _fields_ = [
            ("cb", DWORD),
            ("lpReserved", wintypes.LPWSTR),
            ("lpDesktop", wintypes.LPWSTR),
            ("lpTitle", wintypes.LPWSTR),
            ("dwX", DWORD),
            ("dwY", DWORD),
            ("dwXSize", DWORD),
            ("dwYSize", DWORD),
            ("dwXCountChars", DWORD),
            ("dwYCountChars", DWORD),
            ("dwFillAttribute", DWORD),
            ("dwFlags", DWORD),
            ("wShowWindow", wintypes.WORD),
            ("cbReserved2", wintypes.WORD),
            ("lpReserved2", ctypes.POINTER(ctypes.c_ubyte)),
            ("hStdInput", HANDLE),
            ("hStdOutput", HANDLE),
            ("hStdError", HANDLE),
        ]

    class STARTUPINFOEXW(ctypes.Structure):
        _fields_ = [
            ("StartupInfo", STARTUPINFOW),
            ("lpAttributeList", ctypes.c_void_p),
        ]

    class PROCESS_INFORMATION(ctypes.Structure):
        _fields_ = [
            ("hProcess", HANDLE),
            ("hThread", HANDLE),
            ("dwProcessId", DWORD),
            ("dwThreadId", DWORD),
        ]

    kernel = ctypes.WinDLL("kernel32", use_last_error=True)
    kernel.GetCurrentProcess.argtypes = []
    kernel.GetCurrentProcess.restype = HANDLE
    kernel.GetStdHandle.argtypes = [DWORD]
    kernel.GetStdHandle.restype = HANDLE
    kernel.CreateJobObjectW.argtypes = [ctypes.c_void_p, wintypes.LPCWSTR]
    kernel.CreateJobObjectW.restype = HANDLE
    kernel.SetInformationJobObject.argtypes = [HANDLE, ctypes.c_int, ctypes.c_void_p, DWORD]
    kernel.SetInformationJobObject.restype = BOOL
    kernel.QueryInformationJobObject.argtypes = [HANDLE, ctypes.c_int, ctypes.c_void_p, DWORD, ctypes.POINTER(DWORD)]
    kernel.QueryInformationJobObject.restype = BOOL
    kernel.AssignProcessToJobObject.argtypes = [HANDLE, HANDLE]
    kernel.AssignProcessToJobObject.restype = BOOL
    kernel.TerminateJobObject.argtypes = [HANDLE, wintypes.UINT]
    kernel.TerminateJobObject.restype = BOOL
    kernel.CreateProcessW.argtypes = [
        wintypes.LPCWSTR, wintypes.LPWSTR, ctypes.c_void_p, ctypes.c_void_p,
        BOOL, DWORD, ctypes.c_void_p, wintypes.LPCWSTR, ctypes.c_void_p,
        ctypes.POINTER(PROCESS_INFORMATION),
    ]
    kernel.CreateProcessW.restype = BOOL
    kernel.ResumeThread.argtypes = [HANDLE]
    kernel.ResumeThread.restype = DWORD
    kernel.WaitForSingleObject.argtypes = [HANDLE, DWORD]
    kernel.WaitForSingleObject.restype = DWORD
    kernel.GetExitCodeProcess.argtypes = [HANDLE, ctypes.POINTER(DWORD)]
    kernel.GetExitCodeProcess.restype = BOOL
    kernel.TerminateProcess.argtypes = [HANDLE, wintypes.UINT]
    kernel.TerminateProcess.restype = BOOL
    kernel.DuplicateHandle.argtypes = [HANDLE, HANDLE, HANDLE, ctypes.POINTER(HANDLE), DWORD, BOOL, DWORD]
    kernel.DuplicateHandle.restype = BOOL
    kernel.CloseHandle.argtypes = [HANDLE]
    kernel.CloseHandle.restype = BOOL
    kernel.InitializeProcThreadAttributeList.argtypes = [ctypes.c_void_p, DWORD, DWORD, ctypes.POINTER(SIZE_T)]
    kernel.InitializeProcThreadAttributeList.restype = BOOL
    kernel.UpdateProcThreadAttribute.argtypes = [
        ctypes.c_void_p, DWORD, ULONG_PTR, ctypes.c_void_p, SIZE_T,
        ctypes.c_void_p, ctypes.POINTER(SIZE_T),
    ]
    kernel.UpdateProcThreadAttribute.restype = BOOL
    kernel.DeleteProcThreadAttributeList.argtypes = [ctypes.c_void_p]
    kernel.DeleteProcThreadAttributeList.restype = None

    class WorkerInterrupted(Exception):
        def __init__(self, signum):
            self.signum = signum

    interrupted = {"signum": None}

    def record_signal(signum, _frame):
        interrupted["signum"] = signum

    def check_interruption():
        if interrupted["signum"] is not None:
            raise WorkerInterrupted(interrupted["signum"])

    def last_error(operation):
        error = ctypes.get_last_error()
        return OSError(error, f"{operation} failed with WinError {error}")

    def handle_value(handle):
        if handle is None:
            return 0
        if isinstance(handle, int):
            return handle
        return ctypes.cast(handle, ctypes.c_void_p).value or 0

    def close_handle(handle):
        if handle_value(handle):
            if not kernel.CloseHandle(handle):
                return False
        return True

    old_handlers = {}
    for watched_signal in watched_signals:
        old_handlers[watched_signal] = signal.signal(watched_signal, record_signal)

    job_handle = HANDLE()
    process_info = PROCESS_INFORMATION()  # Preallocated so interrupted CreateProcessW still leaves inspectable handles.
    assignment_attempted = False
    worker_may_have_run = False
    active_marker_created = False
    worker_input_path = None
    worker_input = None
    supervision_marker_identity = None
    scratch_identity = None
    snapshot_identity = None
    duplicate_handles = []
    fallback_streams = []
    attribute_buffer = None
    attribute_list = ctypes.c_void_p()
    attribute_list_initialized = False
    cleanup_proven = True
    requested_status = 125
    timed_out = False
    root_exit_status = None
    diagnostics = []

    def job_active_processes():
        accounting = JOBOBJECT_BASIC_ACCOUNTING_INFORMATION()
        returned = DWORD()
        if not kernel.QueryInformationJobObject(
            job_handle, 1, ctypes.byref(accounting), ctypes.sizeof(accounting), ctypes.byref(returned)
        ):
            raise last_error("QueryInformationJobObject")
        return int(accounting.ActiveProcesses)

    def wait_for_job_empty(seconds):
        end = time.monotonic() + seconds
        while True:
            if job_active_processes() == 0:
                return True
            if time.monotonic() >= end:
                return False
            time.sleep(0.05)

    def terminate_job_and_wait():
        if not kernel.TerminateJobObject(job_handle, 125):
            diagnostics.append(str(last_error("TerminateJobObject")))
            return False
        if not wait_for_job_empty(5.0):
            diagnostics.append("Job Object still reported active processes after bounded termination")
            return False
        return True

    def duplicate_inheritable(source_handle):
        duplicate = HANDLE()
        duplicate_handles.append(duplicate)
        current = kernel.GetCurrentProcess()
        if not kernel.DuplicateHandle(
            current, source_handle, current, ctypes.byref(duplicate), 0, True, 0x00000002
        ):
            raise last_error("DuplicateHandle for child stdio")
        return duplicate

    try:
        scratch_root = os.path.abspath(os.path.dirname(timeout_marker))
        snapshot_root = os.path.dirname(scratch_root)
        if os.path.abspath(os.path.dirname(supervision_marker)) != scratch_root:
            raise RuntimeError("timeout and supervision markers do not share the expected restore root")
        if os.path.dirname(scratch_root) != snapshot_root or scratch_root == snapshot_root:
            raise RuntimeError("restore scratch root is not an ordinary snapshot child")
        snapshot_identity = capture_owned_scratch_identity(snapshot_root)
        scratch_identity = capture_owned_scratch_identity(scratch_root)
        with open(supervision_marker, "x", encoding="ascii") as marker:
            marker.write("owned worker creation is in progress\n")
            marker.flush()
            marker_info = os.fstat(marker.fileno())
            supervision_marker_identity = (marker_info.st_dev, marker_info.st_ino)
        active_marker_created = True
        check_interruption()
        if (
            not os.path.isabs(current_bash_executable)
            or not os.path.isfile(current_bash_executable)
            or not current_bash_executable.lower().endswith(".exe")
        ):
            raise RuntimeError("selected Bash executable is not a native absolute executable file")

        job_handle = kernel.CreateJobObjectW(None, None)
        if not handle_value(job_handle):
            raise last_error("CreateJobObjectW")
        check_interruption()
        job_limits = JOBOBJECT_EXTENDED_LIMIT_INFORMATION()
        job_limits.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE
        if not kernel.SetInformationJobObject(
            job_handle, 9, ctypes.byref(job_limits), ctypes.sizeof(job_limits)
        ):
            raise last_error("SetInformationJobObject")
        check_interruption()

        input_fd, worker_input_path = tempfile.mkstemp(
            prefix=".sqlite-integrity-worker-", suffix=".py", dir=os.path.dirname(timeout_marker)
        )
        with os.fdopen(input_fd, "wb") as input_file:
            input_file.write(worker_script.encode("utf-8"))
        worker_input = open(worker_input_path, "rb", buffering=0)

        stdin_source = msvcrt.get_osfhandle(worker_input.fileno())
        stdin_handle = duplicate_inheritable(ctypes.c_void_p(stdin_source))
        std_handles = []
        for standard_id in (-11, -12):  # stdout and stderr remain connected to the existing checker streams.
            standard_handle = kernel.GetStdHandle(standard_id & 0xFFFFFFFF)
            standard_value = handle_value(standard_handle)
            if not standard_value or standard_value == INVALID_HANDLE_VALUE:
                fallback = open(os.devnull, "wb", buffering=0)
                fallback_streams.append(fallback)
                standard_handle = ctypes.c_void_p(msvcrt.get_osfhandle(fallback.fileno()))
            std_handles.append(duplicate_inheritable(standard_handle))

        startup = STARTUPINFOEXW()
        startup.StartupInfo.cb = ctypes.sizeof(STARTUPINFOEXW)
        startup.StartupInfo.dwFlags = 0x00000100  # STARTF_USESTDHANDLES
        startup.StartupInfo.hStdInput = stdin_handle
        startup.StartupInfo.hStdOutput = std_handles[0]
        startup.StartupInfo.hStdError = std_handles[1]

        attribute_size = SIZE_T()
        kernel.InitializeProcThreadAttributeList(None, 1, 0, ctypes.byref(attribute_size))
        if not attribute_size.value:
            raise last_error("InitializeProcThreadAttributeList size query")
        attribute_buffer = ctypes.create_string_buffer(attribute_size.value)
        attribute_list = ctypes.cast(attribute_buffer, ctypes.c_void_p)
        if not kernel.InitializeProcThreadAttributeList(attribute_list, 1, 0, ctypes.byref(attribute_size)):
            raise last_error("InitializeProcThreadAttributeList")
        attribute_list_initialized = True
        inherited_handles = (HANDLE * 3)(stdin_handle, std_handles[0], std_handles[1])
        if not kernel.UpdateProcThreadAttribute(
            attribute_list, 0, 0x00020002, ctypes.cast(inherited_handles, ctypes.c_void_p),
            ctypes.sizeof(inherited_handles), None, None,
        ):
            raise last_error("UpdateProcThreadAttribute(HANDLE_LIST)")
        startup.lpAttributeList = attribute_list
        check_interruption()

        command_line = ctypes.create_unicode_buffer(subprocess.list2cmdline(worker_command))
        creation_flags = CREATE_SUSPENDED | CREATE_NEW_PROCESS_GROUP | EXTENDED_STARTUPINFO_PRESENT
        created = kernel.CreateProcessW(
            current_bash_executable, command_line, None, None, True, creation_flags,
            None, None, ctypes.byref(startup), ctypes.byref(process_info),
        )
        if not created:
            raise last_error("CreateProcessW")
        check_interruption()

        assignment_attempted = True
        if not kernel.AssignProcessToJobObject(job_handle, process_info.hProcess):
            raise last_error("AssignProcessToJobObject")
        if job_active_processes() != 1:
            raise RuntimeError("Job Object did not report exactly one suspended worker before resume")
        check_interruption()

        previous_suspend_count = kernel.ResumeThread(process_info.hThread)
        if previous_suspend_count == 0xFFFFFFFF:
            raise last_error("ResumeThread")
        worker_may_have_run = previous_suspend_count <= 1
        if previous_suspend_count != 1:
            raise RuntimeError(f"ResumeThread returned unexpected previous suspend count {previous_suspend_count}")
        check_interruption()

        while True:
            check_interruption()
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                wait_result = kernel.WaitForSingleObject(process_info.hProcess, 0)
                if wait_result == 0:
                    break
                if wait_result != 0x00000102:
                    raise last_error("WaitForSingleObject(worker process at deadline)")
                timed_out = True
                requested_status = 124
                break
            wait_ms = max(1, min(100, int(remaining * 1000)))
            wait_result = kernel.WaitForSingleObject(process_info.hProcess, wait_ms)
            if wait_result == 0:
                break
            if wait_result != 0x00000102:
                raise last_error("WaitForSingleObject(worker process)")

        if not timed_out:
            exit_code = DWORD()
            if not kernel.GetExitCodeProcess(process_info.hProcess, ctypes.byref(exit_code)):
                raise last_error("GetExitCodeProcess")
            root_exit_status = int(exit_code.value)
            if root_exit_status == 259:
                raise RuntimeError("worker process handle was signaled while GetExitCodeProcess reported STILL_ACTIVE")
            active_count = job_active_processes()
            if active_count > 0:
                diagnostics.append(
                    f"worker root exited with status {root_exit_status} while its owned Job still had "
                    f"{active_count} active descendant(s)"
                )
                if not terminate_job_and_wait():
                    cleanup_proven = False
                    requested_status = 125
                elif root_exit_status == 0:
                    requested_status = 125
                else:
                    requested_status = root_exit_status
            else:
                requested_status = root_exit_status
    except WorkerInterrupted as interrupted_error:
        requested_status = 128 + interrupted_error.signum
    except BaseException as error:
        requested_status = 125
        diagnostics.append(f"SQLite integrity worker could not be supervised: {error}")
    finally:
        process_handle = process_info.hProcess
        thread_handle = process_info.hThread
        if handle_value(job_handle):
            try:
                active_count = job_active_processes()
                if active_count > 0:
                    if not terminate_job_and_wait():
                        cleanup_proven = False
                if cleanup_proven and job_active_processes() != 0:
                    cleanup_proven = False
                    diagnostics.append("Job Object active-process count did not reach zero")
            except BaseException as error:
                cleanup_proven = False
                diagnostics.append(f"Job Object teardown could not be confirmed: {error}")
                if assignment_attempted and not kernel.TerminateJobObject(job_handle, 125):
                    diagnostics.append(str(last_error("TerminateJobObject after query failure")))

        if handle_value(process_handle):
            wait_result = kernel.WaitForSingleObject(process_handle, 5000 if worker_may_have_run else 0)
            if wait_result == 0x00000102:
                if assignment_attempted and handle_value(job_handle):
                    if not terminate_job_and_wait():
                        cleanup_proven = False
                if not kernel.TerminateProcess(process_handle, 125):
                    diagnostics.append(str(last_error("TerminateProcess(worker handle)")))
                wait_result = kernel.WaitForSingleObject(process_handle, 5000)
            if wait_result != 0:
                cleanup_proven = False
                diagnostics.append("owned worker root process did not signal within the cleanup bound")
        if handle_value(job_handle):
            try:
                if job_active_processes() != 0:
                    cleanup_proven = False
                    diagnostics.append("Job Object still has active processes after root wait")
            except BaseException as error:
                cleanup_proven = False
                diagnostics.append(f"final Job Object query failed: {error}")
                if assignment_attempted and not kernel.TerminateJobObject(job_handle, 125):
                    diagnostics.append(str(last_error("TerminateJobObject after final query failure")))

        if attribute_list_initialized and attribute_list:
            kernel.DeleteProcThreadAttributeList(attribute_list)
        for duplicate in duplicate_handles:
            if not close_handle(duplicate):
                cleanup_proven = False
                diagnostics.append("a duplicated child stdio handle could not be closed")
        if worker_input is not None:
            try:
                worker_input.close()
            except OSError as error:
                cleanup_proven = False
                diagnostics.append(f"temporary worker input handle could not be closed: {error}")
        for fallback in fallback_streams:
            try:
                fallback.close()
            except OSError as error:
                cleanup_proven = False
                diagnostics.append(f"a fallback child stdio handle could not be closed: {error}")
        if not close_handle(thread_handle):
            cleanup_proven = False
            diagnostics.append("the worker primary-thread handle could not be closed")
        if not close_handle(process_handle):
            cleanup_proven = False
            diagnostics.append("the worker process handle could not be closed")
        if not close_handle(job_handle):
            cleanup_proven = False
            diagnostics.append("the private Job Object handle could not be closed")

        if cleanup_proven and interrupted["signum"] is not None and active_marker_created:
            if (
                scratch_identity is None
                or snapshot_identity is None
                or supervision_marker_identity is None
            ):
                cleanup_proven = False
                diagnostics.append("interrupted restore scratch identity was not captured")
            else:
                cleanup_status, cleanup_error = cleanup_interrupted_scratch(
                    scratch_identity[0], snapshot_identity[0], scratch_identity,
                    snapshot_identity, supervision_marker, supervision_marker_identity,
                )
                if cleanup_status != 0:
                    cleanup_proven = False
                    requested_status = 125
                    diagnostics.append(f"interrupted restore scratch cleanup failed: {cleanup_error}")
                else:
                    active_marker_created = False
        elif cleanup_proven:
            if worker_input_path is not None:
                try:
                    os.unlink(worker_input_path)
                except FileNotFoundError:
                    pass
                except OSError as error:
                    requested_status = 125
                    diagnostics.append(f"temporary worker input could not be removed: {error}")
            if active_marker_created:
                try:
                    os.unlink(supervision_marker)
                except FileNotFoundError:
                    pass
                except OSError as error:
                    requested_status = 125
                    diagnostics.append(f"worker supervision marker could not be removed: {error}")
        else:
            requested_status = 125
        if interrupted["signum"] is not None and requested_status != 125:
            requested_status = 128 + interrupted["signum"]

        for watched_signal, old_handler in old_handlers.items():
            signal.signal(watched_signal, old_handler)
        if interrupted["signum"] is not None and requested_status != 125:
            requested_status = 128 + interrupted["signum"]

    if diagnostics:
        for diagnostic in diagnostics:
            print(f"[NG] {diagnostic}", file=sys.stderr)
    if timed_out and requested_status == 124 and cleanup_proven and interrupted["signum"] is None:
        staged_marker = None
        try:
            with tempfile.NamedTemporaryFile(
                mode="w", encoding="ascii", delete=False,
                dir=os.path.dirname(timeout_marker), prefix=".sqlite-timeout-",
            ) as marker:
                staged_marker = marker.name
                marker.write("deadline_expired\n")
            os.replace(staged_marker, timeout_marker)
            staged_marker = None
        except OSError as error:
            if staged_marker is not None:
                try:
                    os.unlink(staged_marker)
                except OSError:
                    pass
            print(f"[NG] SQLite deadline marker could not be created: {error}", file=sys.stderr)
            return 125
    return requested_status


process = None
try:
    if os.name == "nt":
        # Native Windows cannot CreateProcess an extensionless Bash shim. Run
        # both shims and native Python through the already-required Bash with
        # fixed shell text and positional argv; no worker value is interpolated.
        worker_command = [
            current_bash_executable,
            "-c",
            'exec "$@"',
            "rencrow-sqlite-worker",
            bash_argument(worker_python),
            "-",
            *(bash_argument(path) for path in database_paths),
        ]
        try:
            worker_status = run_windows_owned_worker(worker_command)
        except BaseException as error:
            print(f"[NG] SQLite integrity worker could not be supervised: {error}", file=sys.stderr)
            worker_status = 125
        raise SystemExit(worker_status)
    else:
        worker_command = [worker_python, "-", *database_paths]
    process = subprocess.Popen(
        worker_command,
        stdin=subprocess.PIPE,
        start_new_session=(os.name == "posix"),
    )

    try:
        process.communicate(worker_script.encode("utf-8"), timeout=max(0.0, deadline - time.monotonic()))
    except subprocess.TimeoutExpired:
        close_stdin(process)
        if os.name == "posix":
            stopped = stop_posix_process_group(process)
        try:
            process.wait(timeout=5.0)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait(timeout=5.0)
            stopped = False
        if not stopped:
            print("[NG] SQLite integrity worker process group could not be reaped within the cleanup bound", file=sys.stderr)
            raise SystemExit(125)
        with open(timeout_marker, "x", encoding="ascii") as marker:
            marker.write("deadline_expired\n")
        raise SystemExit(124)

    returncode = process.returncode
    if os.name == "posix":
        if process_group_exists(process):
            stopped = stop_posix_process_group(process)
            if not stopped:
                print("[NG] SQLite integrity worker left a process group that could not be reaped", file=sys.stderr)
                raise SystemExit(125)
            if returncode == 0:
                print("[NG] SQLite integrity worker exited with child processes still running", file=sys.stderr)
                returncode = 125
    if returncode < 0:
        returncode = 128 + abs(returncode)
    raise SystemExit(returncode)
except OSError as error:
    if process is not None and process.poll() is None:
        if os.name == "posix":
            stop_posix_process_group(process)
        process.kill()
        try:
            process.wait(timeout=5.0)
        except subprocess.TimeoutExpired:
            pass
    print(f"[NG] SQLite integrity worker could not be supervised: {error}", file=sys.stderr)
    raise SystemExit(125)
finally:
    if process is not None:
        close_stdin(process)
        if os.name == "posix":
            needs_cleanup = process_group_exists(process)
        else:
            needs_cleanup = process.poll() is None
        if needs_cleanup:
            if os.name == "posix":
                stopped = stop_posix_process_group(process)
            if process.poll() is None:
                try:
                    process.kill()
                    process.wait(timeout=5.0)
                except (OSError, subprocess.TimeoutExpired):
                    stopped = False
            if not stopped:
                print("[NG] interrupted SQLite integrity worker process tree could not be reaped within the cleanup bound", file=sys.stderr)
                raise SystemExit(125)
PY
sqlite_integrity_status=$?
set -e
if [[ -e ${sqlite_supervision_marker} ]]; then
  echo "[NG] SQLite integrity worker teardown is unconfirmed; refusing to clean restore scratch" >&2
  exit 125
fi
if [[ -f ${sqlite_timeout_marker} ]]; then
  echo "[NG] SQLite integrity check timed out after ${sqlite_integrity_timeout}s" >&2
  exit 1
fi
if (( sqlite_integrity_status != 0 )); then
  exit "${sqlite_integrity_status}"
fi

if [[ ${format_version} == 4 ]]; then
  "${python_bin}" - "${core_restore}/${conversation_l1_relative}" "${core_restore}/${raw_source_relative}" <<'PY'
import hashlib
import json
import os
import re
import sqlite3
import sys

l1_path, raw_root = sys.argv[1:]
sha256_pattern = re.compile(r"^[0-9a-f]{64}$")

def fail():
    raise SystemExit("Common Raw restore verification failed")

def regular_object(root, reference, expected_hash, expected_size):
    if not isinstance(reference, str) or not reference or "\\" in reference or reference.startswith("/"):
        fail()
    parts = reference.split("/")
    if len(parts) != 4 or parts[0] != "objects" or parts[1] != "sha256":
        fail()
    object_hash = parts[3]
    if not sha256_pattern.fullmatch(object_hash) or parts[2] != object_hash[:2] or reference != "/".join(parts):
        fail()
    if expected_hash != object_hash or not sha256_pattern.fullmatch(expected_hash) or not isinstance(expected_size, int) or isinstance(expected_size, bool) or expected_size < 0:
        fail()
    current = root
    try:
        root_stat = os.lstat(current)
    except OSError:
        fail()
    if os.path.islink(current) or not os.path.isdir(current):
        fail()
    for index, part in enumerate(parts):
        current = os.path.join(current, part)
        try:
            stat = os.lstat(current)
        except OSError:
            fail()
        if os.path.islink(current):
            fail()
        if index < len(parts) - 1:
            if not os.path.isdir(current):
                fail()
        elif not os.path.isfile(current) or stat.st_nlink != 1:
            fail()
    try:
        digest = hashlib.sha256()
        with open(current, "rb") as handle:
            while True:
                chunk = handle.read(1024 * 1024)
                if not chunk:
                    break
                digest.update(chunk)
        if os.stat(current).st_size != expected_size or digest.hexdigest() != expected_hash:
            fail()
    except (OSError, ValueError):
        fail()

try:
    root_stat = os.lstat(raw_root)
except OSError:
    fail()
if os.path.islink(raw_root) or not os.path.isdir(raw_root):
    fail()

try:
    connection = sqlite3.connect(f"file:{l1_path}?mode=ro", uri=True)
    try:
        tables = {row[0] for row in connection.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
        required_tables = {"l1_raw_source_manifest", "l1_raw_record", "l1_raw_state_event", "l1_raw_projection_receipt"}
        if not required_tables.issubset(tables):
            fail()
        rows = connection.execute("SELECT storage_kind, inline_payload, object_ref, content_sha256, content_size, asset_refs_json FROM l1_raw_record")
        for storage_kind, inline_payload, object_ref, content_hash, content_size, asset_refs_json in rows:
            if not sha256_pattern.fullmatch(content_hash or "") or not isinstance(content_size, int) or isinstance(content_size, bool) or content_size < 0:
                fail()
            if storage_kind == "inline":
                if object_ref or inline_payload is None or len(inline_payload) != content_size or hashlib.sha256(inline_payload).hexdigest() != content_hash:
                    fail()
            elif storage_kind == "object":
                if inline_payload is not None:
                    fail()
                regular_object(raw_root, object_ref, content_hash, content_size)
            else:
                fail()
            try:
                asset_refs = json.loads(asset_refs_json)
            except (TypeError, json.JSONDecodeError):
                fail()
            if not isinstance(asset_refs, list):
                fail()
            for asset in asset_refs:
                if not isinstance(asset, dict):
                    fail()
                regular_object(raw_root, asset.get("object_ref"), asset.get("sha256"), asset.get("size"))
    finally:
        connection.close()
except (sqlite3.Error, OSError, TypeError, ValueError):
    fail()
PY
fi

if [[ ${redis_export} != disabled ]]; then
