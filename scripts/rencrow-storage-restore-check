#!/usr/bin/env bash
set -Eeuo pipefail

python_bin=${RENCROW_TEST_PYTHON:-python3}
sqlite_integrity_timeout=${RENCROW_SQLITE_INTEGRITY_TIMEOUT_SEC:-600}
umask 077

if [[ ! ${sqlite_integrity_timeout} =~ ^[1-9][0-9]*$ ]] || (( sqlite_integrity_timeout > 3600 )); then
  echo "[NG] SQLite integrity timeout must be 1..3600 seconds" >&2
  exit 2
fi

snapshot_dir=${1:-}
if [[ -z ${snapshot_dir} || ! -d ${snapshot_dir} ]]; then
  echo "usage: rencrow-storage-restore-check SNAPSHOT_DIR" >&2
  exit 2
fi

archive=${snapshot_dir}/rencrow-state.tar.gz
manifest=${snapshot_dir}/manifest.txt
checksums=${snapshot_dir}/SHA256SUMS
for required in "${archive}" "${manifest}" "${checksums}"; do
  if [[ ! -f ${required} ]]; then
    echo "[NG] required snapshot file is missing: ${required}" >&2
    exit 1
  fi
done

manifest_value() {
  local key=$1
  awk -F= -v key="${key}" '$1 == key {sub(/^[^=]*=/, ""); print; exit}' "${manifest}"
}

format_version=$(manifest_value format_version)
core_name=$(manifest_value core_name)
session_relative=$(manifest_value session_relative)
operation_memory_relative=$(manifest_value operation_memory_relative)
cold_export_relative=$(manifest_value cold_export_relative)
raw_source_relative=$(manifest_value raw_source_relative)
conversation_l1_relative=$(manifest_value conversation_l1_relative)
conversation_archive_relative=$(manifest_value conversation_archive_relative)
redis_export=$(manifest_value redis_export)
qdrant_export=$(manifest_value qdrant_export)
qdrant_sha256=$(manifest_value qdrant_sha256)
thread_identity_export=$(manifest_value thread_identity_export)
thread_identity_snapshot_sha256=$(manifest_value thread_identity_snapshot_sha256)
thread_identity_quiesce_receipt=$(manifest_value thread_identity_quiesce_receipt)
thread_identity_quiesce_sha256=$(manifest_value thread_identity_quiesce_sha256)

if [[ ( ${format_version} != 2 && ${format_version} != 3 && ${format_version} != 4 && ${format_version} != 5 ) || -z ${core_name} || ${core_name} == */* ]]; then
  echo "[NG] unsupported or unsafe snapshot manifest" >&2
  exit 1
fi
if [[ ${format_version} == 5 ]] && \
   [[ ${thread_identity_export} != external-memory/thread-identity/external-snapshot.json || ! ${thread_identity_snapshot_sha256} =~ ^[0-9a-f]{64}$ || \
      ${thread_identity_quiesce_receipt} != external-memory/thread-identity/sqlite-quiesce.json || ! ${thread_identity_quiesce_sha256} =~ ^[0-9a-f]{64}$ ]]; then
  echo "[NG] unsupported or unsafe snapshot manifest" >&2
  exit 1
fi

safe_relative() {
  local value=$1
  local normalized=${value//\\//}
  if [[ -z ${value} || ${value} == /* || ${value} == \\\\* || ${normalized} == /* || ${normalized} == *:* ]]; then
    return 1
  fi
  if [[ ${normalized} == . ]]; then
    return 0
  fi
  if [[ ${normalized} == */. || ${normalized} == */./* || ${normalized} == */../* || ${normalized} == .. || ${normalized} == ../* || ${normalized} == */.. ]]; then
    return 1
  fi
  local part
  IFS=/ read -r -a parts <<< "${normalized}"
  for part in "${parts[@]}"; do
    if [[ -z ${part} || ${part} == . || ${part} == .. ]]; then
      return 1
    fi
  done
  return 0
}

(
  cd "${snapshot_dir}"
  sha256sum -c SHA256SUMS
)
gzip -t "${archive}"

tar -tzf "${archive}" | "${python_bin}" -c '
import sys
for raw in sys.stdin:
    name = raw.strip()
    parts = [part for part in name.split("/") if part not in ("", ".")]
    if name.startswith("/") or ".." in parts:
        raise SystemExit("unsafe archive path: " + name)
'

restore_root=$(mktemp -d "${snapshot_dir}/.restore.XXXXXX")
cleanup() {
  local status=$?
  trap - EXIT INT TERM
  if [[ -n ${restore_root:-} && -d ${restore_root} ]]; then
    rm -rf -- "${restore_root}"
  fi
  exit "${status}"
}
trap cleanup EXIT INT TERM

tar -xzf "${archive}" -C "${restore_root}"
core_restore=${restore_root}/${core_name}

required_relatives=("${session_relative}" "${operation_memory_relative}" "${cold_export_relative}")
if [[ ${format_version} == 4 || ${format_version} == 5 ]]; then
  required_relatives+=("${raw_source_relative}")
fi
for relative in "${required_relatives[@]}"; do
  if ! safe_relative "${relative}"; then
    echo "[NG] unsafe required directory in manifest: ${relative}" >&2
    exit 1
  fi
  if [[ ! -d ${core_restore}/${relative} ]]; then
    echo "[NG] required memory directory is missing from snapshot: ${relative}" >&2
    exit 1
  fi
done
for relative in "${conversation_l1_relative}" "${conversation_archive_relative}"; do
  if ! safe_relative "${relative}"; then
    echo "[NG] unsafe SQLite path in manifest" >&2
    exit 1
  fi
done

set +e
timeout --signal=TERM "${sqlite_integrity_timeout}s" \
  "${python_bin}" - "${core_restore}/${conversation_l1_relative}" "${core_restore}/${conversation_archive_relative}" <<'PY'
import sqlite3
import sys

for path in sys.argv[1:]:
    if not path or "/../" in path:
        raise SystemExit("unsafe SQLite path")
    with open(path, "rb") as handle:
        if handle.read(16) != b"SQLite format 3\x00":
            raise SystemExit(f"not a SQLite database: {path}")
    connection = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
    try:
        result = connection.execute("PRAGMA integrity_check").fetchone()
    finally:
        connection.close()
    if not result or result[0] != "ok":
        raise SystemExit(f"SQLite integrity check failed: {path}: {result}")
PY
sqlite_integrity_status=$?
set -e
if (( sqlite_integrity_status == 124 || sqlite_integrity_status == 137 )); then
  echo "[NG] SQLite integrity check timed out after ${sqlite_integrity_timeout}s" >&2
  exit 1
fi
if (( sqlite_integrity_status != 0 )); then
  exit "${sqlite_integrity_status}"
fi

if [[ ${format_version} == 4 || ${format_version} == 5 ]]; then
  "${python_bin}" - "${core_restore}/${conversation_l1_relative}" "${core_restore}/${raw_source_relative}" <<'PY'
import hashlib
import json
import os
import re
import sqlite3
import sys

l1_path, raw_root = sys.argv[1:]
sha256_pattern = re.compile(r"^[0-9a-f]{64}$")

def fail():
    raise SystemExit("Common Raw restore verification failed")

def regular_object(root, reference, expected_hash, expected_size):
    if not isinstance(reference, str) or not reference or "\\" in reference or reference.startswith("/"):
        fail()
    parts = reference.split("/")
    if len(parts) != 4 or parts[0] != "objects" or parts[1] != "sha256":
        fail()
    object_hash = parts[3]
    if not sha256_pattern.fullmatch(object_hash) or parts[2] != object_hash[:2] or reference != "/".join(parts):
        fail()
    if expected_hash != object_hash or not sha256_pattern.fullmatch(expected_hash) or not isinstance(expected_size, int) or isinstance(expected_size, bool) or expected_size < 0:
        fail()
    current = root
    try:
        root_stat = os.lstat(current)
    except OSError:
        fail()
    if os.path.islink(current) or not os.path.isdir(current):
        fail()
    for index, part in enumerate(parts):
        current = os.path.join(current, part)
        try:
            stat = os.lstat(current)
        except OSError:
            fail()
        if os.path.islink(current):
            fail()
        if index < len(parts) - 1:
            if not os.path.isdir(current):
                fail()
        elif not os.path.isfile(current) or stat.st_nlink != 1:
            fail()
    try:
        digest = hashlib.sha256()
        with open(current, "rb") as handle:
            while True:
                chunk = handle.read(1024 * 1024)
                if not chunk:
                    break
                digest.update(chunk)
        if os.stat(current).st_size != expected_size or digest.hexdigest() != expected_hash:
            fail()
    except (OSError, ValueError):
        fail()

try:
    root_stat = os.lstat(raw_root)
except OSError:
    fail()
if os.path.islink(raw_root) or not os.path.isdir(raw_root):
    fail()

try:
    connection = sqlite3.connect(f"file:{l1_path}?mode=ro", uri=True)
    try:
        tables = {row[0] for row in connection.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
        required_tables = {"l1_raw_source_manifest", "l1_raw_record", "l1_raw_state_event", "l1_raw_projection_receipt"}
        if not required_tables.issubset(tables):
            fail()
        rows = connection.execute("SELECT storage_kind, inline_payload, object_ref, content_sha256, content_size, asset_refs_json FROM l1_raw_record")
        for storage_kind, inline_payload, object_ref, content_hash, content_size, asset_refs_json in rows:
            if not sha256_pattern.fullmatch(content_hash or "") or not isinstance(content_size, int) or isinstance(content_size, bool) or content_size < 0:
                fail()
            if storage_kind == "inline":
                if object_ref or inline_payload is None or len(inline_payload) != content_size or hashlib.sha256(inline_payload).hexdigest() != content_hash:
                    fail()
            elif storage_kind == "object":
                if inline_payload is not None:
                    fail()
                regular_object(raw_root, object_ref, content_hash, content_size)
            else:
                fail()
            try:
                asset_refs = json.loads(asset_refs_json)
            except (TypeError, json.JSONDecodeError):
                fail()
            if not isinstance(asset_refs, list):
                fail()
            for asset in asset_refs:
                if not isinstance(asset, dict):
                    fail()
                regular_object(raw_root, asset.get("object_ref"), asset.get("sha256"), asset.get("size"))
    finally:
        connection.close()
except (sqlite3.Error, OSError, TypeError, ValueError):
    fail()
PY
fi

if [[ ${format_version} == 5 ]]; then
  thread_identity_binary=${RENCROW_THREAD_MIGRATION_BINARY:-${HOME}/.local/bin/rencrow-thread-migrate}
  thread_identity_path=${restore_root}/${thread_identity_export}
  thread_identity_quiesce_path=${restore_root}/${thread_identity_quiesce_receipt}
  thread_identity_external_root=${restore_root}/external-memory
  thread_identity_directory=${thread_identity_external_root}/thread-identity
  if [[ ! -d ${thread_identity_external_root} || -L ${thread_identity_external_root} ||
        ! -d ${thread_identity_directory} || -L ${thread_identity_directory} ||
        ! -f ${thread_identity_path} || -L ${thread_identity_path} || ! -s ${thread_identity_path} || \
        ! -f ${thread_identity_quiesce_path} || -L ${thread_identity_quiesce_path} || ! -s ${thread_identity_quiesce_path} || \
        $(sha256sum "${thread_identity_quiesce_path}" | cut -d' ' -f1) != "${thread_identity_quiesce_sha256}" ]]; then
    echo "[NG] Thread identity external snapshot verification failed" >&2
    exit 1
  fi
  if ! "${python_bin}" - "${thread_identity_quiesce_path}" "${core_restore}/${conversation_l1_relative}" "${core_restore}/${conversation_archive_relative}" <<'PY'
import hashlib
import json
import os
import re
import sys

path, l1_path, archive_path = sys.argv[1:]
try:
    raw = open(path, "rb").read()
    if len(raw) > 65536 or not raw.endswith(b"\n") or raw.count(b"\n") != 1:
        raise ValueError
    def reject_duplicate_keys(pairs):
        value = {}
        for key, item in pairs:
            if key in value:
                raise ValueError
            value[key] = item
        return value
    value = json.loads(raw[:-1], object_pairs_hook=reject_duplicate_keys)
except (OSError, TypeError, ValueError):
    raise SystemExit(1)
required = [
    "schema_version", "status", "sqlite_sources", "busy_zero",
    "journal_mode_delete", "same_file", "sidecar_zero", "l1_sha256",
    "archive_sha256", "receipt_sha256", "error_code",
]
if list(value) != required or value.get("schema_version") != "rencrow.threadmigration.sqlite_quiesce.v1" or value.get("status") != "quiesced_not_snapshot_bound":
    raise SystemExit(1)
if value.get("sqlite_sources") != 2 or any(value.get(key) is not True for key in ("busy_zero", "journal_mode_delete", "same_file", "sidecar_zero")) or value.get("error_code") != "":
    raise SystemExit(1)
pattern = re.compile(r"^[0-9a-f]{64}$")
if any(not isinstance(value.get(key), str) or not pattern.fullmatch(value[key]) for key in ("l1_sha256", "archive_sha256", "receipt_sha256")):
    raise SystemExit(1)
actual = value["receipt_sha256"]
value["receipt_sha256"] = ""
canonical = json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode()
if hashlib.sha256(canonical).hexdigest() != actual:
    raise SystemExit(1)
def regular_sha256(database_path):
    metadata = os.lstat(database_path)
    if os.path.islink(database_path) or not os.path.isfile(database_path) or metadata.st_nlink != 1:
        raise ValueError
    digest = hashlib.sha256()
    with open(database_path, "rb") as handle:
        while chunk := handle.read(1024 * 1024):
            digest.update(chunk)
    return digest.hexdigest()
try:
    if regular_sha256(l1_path) != value["l1_sha256"] or regular_sha256(archive_path) != value["archive_sha256"]:
        raise ValueError
except (OSError, ValueError):
    raise SystemExit(1)
PY
  then
    echo "[NG] Thread identity SQLite quiesce receipt verification failed" >&2
    exit 1
  fi
  if [[ ! -f ${thread_identity_binary} || -L ${thread_identity_binary} || ! -x ${thread_identity_binary} ]]; then
    echo "[NG] Thread identity external snapshot verification failed" >&2
    exit 1
  fi

  thread_identity_receipt=$(mktemp "${restore_root}/.thread-identity-verify.XXXXXX")
  set +e
  (
    ulimit -f 128
    timeout --signal=TERM 300s "${thread_identity_binary}" verify-external --input "${thread_identity_path}"
  ) >"${thread_identity_receipt}" 2>/dev/null
  thread_identity_verify_status=$?
  set -e
  if (( thread_identity_verify_status != 0 )); then
    if (( thread_identity_verify_status == 124 || thread_identity_verify_status == 137 )); then
      echo "[NG] Thread identity external snapshot verification timed out" >&2
    else
      echo "[NG] Thread identity external snapshot verification failed" >&2
    fi
    exit 1
  fi

  if ! "${python_bin}" - "${thread_identity_receipt}" "${thread_identity_snapshot_sha256}" <<'PY'
import json
import re
import sys

receipt_path, expected_snapshot_sha256 = sys.argv[1:]
sha256_pattern = re.compile(r"^[0-9a-f]{64}$")
required_keys = {
    "schema",
    "status",
    "redis_count",
    "qdrant_count",
    "redis_sha256",
    "qdrant_sha256",
    "snapshot_sha256",
    "error_code",
}

def reject_duplicate_keys(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise ValueError("duplicate key")
        value[key] = item
    return value

def reject_constant(value):
    raise ValueError("non-standard JSON number")

try:
    with open(receipt_path, "rb") as handle:
        raw = handle.read()
    if len(raw) > 65536 or not raw.endswith(b"\n") or b"\n" in raw[:-1]:
        raise ValueError("receipt must be one bounded JSON line")
    payload = raw[:-1].decode("utf-8")
    decoder = json.JSONDecoder(
        object_pairs_hook=reject_duplicate_keys,
        parse_constant=reject_constant,
    )
    value, end = decoder.raw_decode(payload)
    if end != len(payload) or not isinstance(value, dict):
        raise ValueError("receipt must contain one JSON object")
    if set(value) != required_keys:
        raise ValueError("receipt schema keys differ")
    if value["schema"] != "rencrow.threadmigration.verify_external.v1":
        raise ValueError("receipt schema differs")
    if value["status"] != "verified" or value["error_code"] != "":
        raise ValueError("receipt status is not verified")
    for key in ("redis_count", "qdrant_count"):
        count = value[key]
        if not isinstance(count, int) or isinstance(count, bool) or count < 0:
            raise ValueError("receipt count is invalid")
    for key in ("redis_sha256", "qdrant_sha256", "snapshot_sha256"):
        digest = value[key]
        if not isinstance(digest, str) or not sha256_pattern.fullmatch(digest):
            raise ValueError("receipt hash is invalid")
    if value["snapshot_sha256"] != expected_snapshot_sha256:
        raise ValueError("receipt snapshot hash differs")
except (OSError, UnicodeDecodeError, TypeError, ValueError, json.JSONDecodeError):
    raise SystemExit(1)
PY
  then
    echo "[NG] Thread identity external snapshot verification failed" >&2
    exit 1
  fi
fi

if [[ ${redis_export} != disabled ]]; then
  redis_path=${restore_root}/${redis_export}
  if [[ ! -s ${redis_path} || $(head -c 5 "${redis_path}") != REDIS ]]; then
    echo "[NG] Redis RDB is missing or invalid" >&2
    exit 1
  fi
fi
if [[ ${qdrant_export} != disabled ]]; then
  qdrant_path=${restore_root}/${qdrant_export}
  if [[ ! -s ${qdrant_path} ]]; then
    echo "[NG] Qdrant snapshot is missing or empty" >&2
    exit 1
  fi
  if [[ ${format_version} == 3 ]]; then
    if [[ ! ${qdrant_sha256} =~ ^[0-9a-f]{64}$ ]]; then
      echo "[NG] Qdrant snapshot checksum metadata is invalid" >&2
      exit 1
    fi
    printf '%s  %s\n' "${qdrant_sha256}" "${qdrant_path}" | sha256sum -c -
  fi
fi

echo "[OK] snapshot is checksum-valid, extractable, and restorable: ${snapshot_dir}"
